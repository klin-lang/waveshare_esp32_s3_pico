// Waveshare ESP32-S3-Pico: LEDC PWM fade on Pico D10 (GPIO35).
// External LED+resistor on D10 — not the onboard WS2812 (see examples/rgb).
import "github/klin-lang/machine_esp" machine
import "../../waveshare_esp32_s3_pico" board

@[cexport, codename("klin_app_main")]
fn pwm_main() {
    let led = machine.pwm_out_s3(board.d10(), 0, 0, board.peri_hz())
    led.freq(1000)
    while true {
        let mut d: i32 = 0
        while d <= 65535 {
            led.duty_u16(d)
            let mut i: i32 = 0
            while i < 8000 {
                i = i + 1
            }
            d = d + 1024
        }
        d = 65535
        while d >= 0 {
            led.duty_u16(d)
            let mut i: i32 = 0
            while i < 8000 {
                i = i + 1
            }
            d = d - 1024
        }
    }
}

fn main() {
    pwm_main()
}
