// Waveshare ESP32-S3-Pico UART0 on Pico GP0/GP1 (D0/D1 → GPIO11/12).
// 115200 8N1, APB peri_hz. hello + echo.
import "github/klin-lang/machine_esp" machine
import "../../waveshare_esp32_s3_pico" board

@[cexport, codename("klin_app_main")]
fn uart_main() {
    let u = machine.uart_out_s3(0, board.uart0_tx(), board.uart0_rx(), board.peri_hz(), 115200)
    let mut msg: [6]u8
    msg[0] = 104
    msg[1] = 101
    msg[2] = 108
    msg[3] = 108
    msg[4] = 111
    msg[5] = 10
    while true {
        u.write(msg)
        if u.any() {
            let b = u.read_u8()
            u.write_u8(b)
        }
        let mut i: i32 = 0
        while i < 2000000 {
            i = i + 1
        }
    }
}

fn main() {
    uart_main()
}
