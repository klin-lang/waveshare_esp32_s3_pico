// Waveshare ESP32-S3-Pico: blink Pico silkscreen D10 (GPIO35).
// Onboard WS2812 is GPIO21 — see examples/rgb. Boot via ESP-IDF.
import "github/klin-lang/machine_esp" machine
import "../../waveshare_esp32_s3_pico" board

@[cexport, codename("klin_app_main")]
fn blink_main() {
    let led = machine.pin_out_s3(board.d10())
    while true {
        led.toggle()
        let mut i: i32 = 0
        while i < 2000000 {
            i = i + 1
        }
    }
}

fn main() {
    blink_main()
}
