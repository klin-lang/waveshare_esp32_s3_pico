/// Waveshare ESP32-S3-Pico pin map (Pico silkscreen → ESP32-S3 GPIO).
/// Source: Waveshare wiki MicroPython pin table (ESP32-S3R2).
/// Use with `machine_esp` `*_s3` factories — not C3 `pin_out`.
module waveshare_esp32_s3_pico

/// Assumed APB / peri Hz under typical ESP-IDF defaults (explicit — no clock read).
pub fn peri_hz(): i32 {
    return 80000000
}

/// XTAL Hz (I2C source clock when using `i2c_out_s3`).
pub fn xtal_hz(): i32 {
    return 40000000
}

/// Onboard WS2812 data (NeoPixel) — not a plain LED.
pub fn rgb(): i32 {
    return 21
}

/// USB VBUS sense ADC (GPIO3).
pub fn usb_adc(): i32 {
    return 3
}

// --- Digital (Pico D0..D28 silkscreen) ---

pub fn d0(): i32 { return 11 }
pub fn d1(): i32 { return 12 }
pub fn d2(): i32 { return 13 }
pub fn d3(): i32 { return 14 }
pub fn d4(): i32 { return 15 }
pub fn d5(): i32 { return 16 }
pub fn d6(): i32 { return 17 }
pub fn d7(): i32 { return 18 }
pub fn d8(): i32 { return 33 }
pub fn d9(): i32 { return 34 }
pub fn d10(): i32 { return 35 }
pub fn d11(): i32 { return 36 }
pub fn d12(): i32 { return 37 }
pub fn d13(): i32 { return 38 }
pub fn d14(): i32 { return 39 }
pub fn d15(): i32 { return 40 }
pub fn d16(): i32 { return 42 }
pub fn d17(): i32 { return 41 }
pub fn d18(): i32 { return 1 }
pub fn d19(): i32 { return 2 }
pub fn d20(): i32 { return 4 }
pub fn d21(): i32 { return 5 }
pub fn d22(): i32 { return 6 }
pub fn d26(): i32 { return 7 }
pub fn d27(): i32 { return 8 }
pub fn d28(): i32 { return 9 }

/// Pico-style ADC aliases (same GPIOs as D26..D28).
pub fn a1(): i32 { return 7 }
pub fn a2(): i32 { return 8 }
pub fn a3(): i32 { return 9 }

/// Default UART0 matrix pins matching Pico GP0/GP1 silkscreen (D0/D1).
pub fn uart0_tx(): i32 { return 11 }
pub fn uart0_rx(): i32 { return 12 }

/// I2C0 on Pico GP6/GP7 silkscreen (D6/D7).
pub fn i2c0_sda(): i32 { return 17 }
pub fn i2c0_scl(): i32 { return 18 }

/// SPI2 (FSPI) on Pico GP10/GP11/GP12 silkscreen (D10/D11/D12) — soft CS.
pub fn spi_sck(): i32 { return 35 }
pub fn spi_mosi(): i32 { return 36 }
pub fn spi_miso(): i32 { return 37 }
